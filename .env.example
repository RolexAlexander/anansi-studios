# Copy this file to .env and fill in real values. Never commit .env.
GOOGLE_API_KEY=
PARALLEL_API_KEY=

# Set to 1 to skip real API calls in the tool layer (structural dry runs only).
# Note: the ADK LlmAgents themselves still require a real GOOGLE_API_KEY to run at all,
# since ADK calls the model directly. This flag only stubs the Parallel + Imagen calls.
STUDIO_MOCK=0
